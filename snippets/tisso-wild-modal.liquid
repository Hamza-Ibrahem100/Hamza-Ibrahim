<!-- ═══════════════════════════════════════════════════════════════════════
     Tisso Wild — 3-Step Hotspot UI
     Step 1: Hotspot (+/×) is the SOLE toggle for the mini-card.
             No close button on the mini-card itself.
     Step 2: Mini-card is clickable → opens full modal.
     Step 3: Full modal handles variant selection + Add to Cart.
     ═══════════════════════════════════════════════════════════════════════ -->

<!-- ── STEP 1 & 2: Mini-Card (NO close button, anchors to hotspot) ────── -->
<!--   JS moves this element to <body> on load so position:absolute        -->
<!--   works in document coordinates and scrolls with the page.            -->

<div
  id="hotspot-mini-card"
  class="hotspot-mini-card"
  role="complementary"
  aria-label="Product quick view — click to see full details"
  hidden
>
  <!-- Entire row is clickable (triggers Full Modal via JS) -->
  <div class="mini-card__row">
    <div class="mini-card__image-wrap">
      <img id="mini-card-image" class="mini-card__image" src="" alt="" loading="lazy">
    </div>
    <div class="mini-card__info">
      <p id="mini-card-title" class="mini-card__title"></p>
      <p id="mini-card-price" class="mini-card__price"></p>
      <span class="mini-card__cta">View details &rarr;</span>
    </div>
  </div>
</div>


<!-- ── STEP 3: Full Modal (centred overlay, dimmed backdrop) ──────────── -->

<div id="full-modal-overlay" class="full-modal-overlay" hidden>
  <div class="full-modal" role="dialog" aria-modal="true" aria-labelledby="modal-product-title">

    <!-- × closes Full Modal only -->
    <button id="full-modal-close" class="full-modal__close" aria-label="Close">&times;</button>

    <!-- Top row -->
    <div class="full-modal__top-row">
      <div class="full-modal__image-wrap">
        <img id="modal-product-image" class="full-modal__image" src="" alt="" loading="lazy">
      </div>
      <div class="full-modal__info">
        <h3 id="modal-product-title" class="full-modal__title"></h3>
        <p  id="modal-product-price" class="full-modal__price"></p>
        <div id="modal-product-description" class="full-modal__description"></div>
      </div>
    </div>

    <!-- Variant options injected by JS -->
    <div id="modal-options-wrap"></div>

    <!-- Add to Cart -->
    <button id="modal-add-to-cart" class="full-modal__add-btn" type="button" disabled>
      <span>ADD TO CART</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 12H20M20 12L13 5M20 12L13 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

  </div>
</div>
