<!-- ═══════════════════════════════════════════════════════════════════════
     Tisso Wild — Pixel-Perfect Product Quick View Modal
     ═══════════════════════════════════════════════════════════════════════ -->

<style>
  /* Modal Card Wrapper: White card, 8px border-radius, thin light-gray border, soft shadow, ~340px width */
  .full-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1100;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .full-modal-overlay[hidden] {
    display: none;
  }

  .full-modal-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .full-modal {
    background: #ffffff;
    width: 340px;
    max-width: 92vw;
    max-height: 90vh;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    overflow: visible;
    position: relative;
    padding: 24px;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    box-sizing: border-box;
    transform: translateY(12px);
    transition: transform 0.22s ease;
  }

  .full-modal-overlay.is-visible .full-modal {
    transform: translateY(0);
  }

  /* Close Icon 'X' top right */
  .full-modal__close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    font-size: 20px;
    font-weight: 300;
    line-height: 1;
    color: #000000;
    cursor: pointer;
    padding: 4px;
    transition: opacity 0.15s ease;
  }

  .full-modal__close:hover {
    opacity: 0.6;
  }

  /* Header / Top Section: Image left, Product info right */
  .full-modal__top-row {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
  }

  .full-modal__image-wrap {
    width: 110px;
    height: 110px;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    overflow: hidden;
    background: #f7f7f7;
    border-radius: 0;
  }

  .full-modal__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .full-modal__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .full-modal__title {
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 6px 0;
    color: #111111;
  }

  .full-modal__price {
    font-family: 'Lustria', var(--font-heading--family, Georgia, serif);
    font-size: 16px;
    font-weight: 400;
    color: #000000;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .full-modal__description {
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.45;
    color: #666666;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Option Group Labels */
  .modal-option-group {
    margin-bottom: 16px;
  }

  .modal-option-label {
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 400;
    color: #333333;
    display: block;
    margin-bottom: 7px;
    text-transform: none;
  }

  /* Option Swatch Button: White background, 1px black border, centered text */
  .modal-swatch-row {
    display: flex;
    width: 100%;
    gap: 0;
  }

  .modal-swatch {
    position: relative;
    flex: 1;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #000000 !important;
    cursor: pointer;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 14px;
    font-weight: 400;
    text-align: center;
    user-select: none;
    outline: none;
    box-sizing: border-box;
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .modal-swatch + .modal-swatch {
    border-left: none !important;
  }

  .modal-swatch:active {
    transform: scale(0.98);
  }

  /* Full-Height 5px Left Selection Bar Flush With Left Edge */
  .modal-swatch-indicator {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px !important;
    height: 100% !important;
    border-radius: 0 !important;
    background-color: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
    transition: background-color 200ms ease, opacity 200ms ease;
    pointer-events: none;
  }

  /* Selected State: Solid Black Selection Bar (#000000), White Background, Bold Text */
  .modal-swatch.is-selected .modal-swatch-indicator,
  .modal-swatch.active .modal-swatch-indicator {
    background-color: #000000 !important;
  }

  .modal-swatch.is-selected,
  .modal-swatch.active {
    background: #ffffff !important;
    color: #000000 !important;
    border-color: #000000 !important;
    font-weight: 700 !important;
  }

  .modal-swatch-text {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  /* Size Section: Custom Select Input + Attached Right Caret Button */
  .modal-custom-select-wrap {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .modal-size-select-box {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }

  .modal-size-select-main {
    flex: 1;
    height: 44px;
    padding: 0 16px;
    border: 1px solid #000000;
    background: #ffffff;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 14px;
    color: #000000;
    text-align: left;
    display: flex;
    align-items: center;
    cursor: pointer;
    outline: none;
    box-sizing: border-box;
    border-radius: 0;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .modal-size-select-main:active {
    transform: scale(0.98);
  }

  .modal-size-select-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid #000000;
    margin-left: -1px;
    background: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    outline: none;
    box-sizing: border-box;
    border-radius: 0;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .modal-size-select-arrow:active {
    transform: scale(0.98);
  }

  .modal-caret-icon {
    transition: transform 0.2s ease;
    transform: rotate(0deg); /* Points DOWN when closed */
  }

  .modal-size-select-box.is-open .modal-caret-icon {
    transform: rotate(180deg); /* Points UP when open */
  }

  /* Dropdown Menu List: Center text, hover black background with white text, 24px bottom padding */
  .modal-custom-select-list,
  .modal-custom-select-list ul {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    z-index: 100;
    background: #ffffff;
    border: 1px solid #000000;
    margin-top: -1px;
    padding: 0 !important;
    margin: 0 !important;
    padding-bottom: 24px !important;
    margin-bottom: 0 !important;
    list-style: none !important;
    overflow: hidden;
    display: none;
  }

  .modal-custom-select-option {
    padding: 12px 16px;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 14px;
    color: #000000 !important;
    text-align: center;
    cursor: pointer !important;
    background: #ffffff !important;
    border-bottom: 1px solid #eeeeee;
    box-sizing: border-box;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .modal-custom-select-option:last-child {
    border-bottom: none;
  }

  .modal-custom-select-option:hover,
  .modal-custom-select-option:focus {
    background: #000000 !important;
    color: #ffffff !important;
  }

  .modal-custom-select-option:active {
    transform: scale(0.99);
  }

  /* Bottom: Full-width solid black button, white uppercase text, white arrow aligned right */
  .full-modal__add-btn {
    width: 100%;
    height: 48px;
    margin-top: 20px;
    background: #000000 !important;
    color: #ffffff !important;
    border: none;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    box-sizing: border-box;
    opacity: 1;
    transition: transform 0.15s ease, opacity 0.15s ease, background 0.15s ease;
  }

  .full-modal__add-btn:not(:disabled):hover {
    background: #111111 !important;
    color: #ffffff !important;
  }

  .full-modal__add-btn:not(:disabled):active {
    transform: scale(0.98);
    opacity: 0.88;
    background: #000000 !important;
  }

  .full-modal__add-btn:disabled {
    background: #999999 !important;
    color: #ffffff !important;
    cursor: not-allowed !important;
    opacity: 0.75;
  }

  .full-modal__add-btn svg {
    width: 24px;
    height: 12px;
  }
</style>

<div id="full-modal-overlay" class="full-modal-overlay" hidden>
  <div class="full-modal" role="dialog" aria-modal="true" aria-labelledby="modal-product-title">

    <!-- Minimal Top Right Close Icon 'X' -->
    <button id="full-modal-close" class="full-modal__close" aria-label="Close">&times;</button>

    <!-- Top Section: Product Info (Square Image + Title, Price, Description) -->
    <div class="full-modal__top-row">
      <div class="full-modal__image-wrap">
        <img id="modal-product-image" class="full-modal__image" src="" alt="" loading="lazy">
      </div>
      <div class="full-modal__info">
        <h3 id="modal-product-title" class="full-modal__title"></h3>
        <p  id="modal-product-price" class="full-modal__price"></p>
        <div id="modal-product-description" class="full-modal__description"></div>
      </div>
    </div>

    <!-- Variant Options (Color swatches & Size custom dropdown injected by JS) -->
    <div id="modal-options-wrap"></div>

    <!-- Add to Cart Button -->
    <button id="modal-add-to-cart" class="full-modal__add-btn" type="button" disabled>
      <span>ADD TO CART</span>
      <svg width="24" height="12" viewBox="0 0 24 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 6H22M22 6L16 1M22 6L16 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

  </div>
</div>
