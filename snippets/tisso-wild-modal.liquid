<!-- Product Popup Card Snippet — minimal floating card (image + title + price only) -->

<!-- Transparent backdrop catches outside clicks -->
<div id="product-popup-backdrop" class="product-popup-backdrop" hidden></div>

<!-- Floating popup card -->
<div
  id="product-popup-card"
  class="product-popup-card"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-product-title"
  hidden
>
  <!-- Close button — circular, overlaps top-right corner of card -->
  <button class="product-popup__close" id="product-popup-close" aria-label="Close">
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 1L11 11M11 1L1 11" stroke="#000" stroke-width="1.75" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Content row: image left, text right -->
  <div class="product-popup__row">
    <div class="product-popup__image-wrap">
      <img id="popup-product-image" class="product-popup__image" src="" alt="" loading="lazy">
    </div>
    <div class="product-popup__info">
      <h3 id="popup-product-title" class="product-popup__title"></h3>
      <p  id="popup-product-price" class="product-popup__price"></p>
    </div>
  </div>
</div>
