<!-- ═══════════════════════════════════════════════════════════════════════
     Tisso Wild — Product Quick View Modal (Dynamic Color Indicators)
     ═══════════════════════════════════════════════════════════════════════ -->

<style>
  /* Modal Overlay & Card Container: No card scrollbar, overflow hidden */
  .full-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1100;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .full-modal-overlay[hidden] {
    display: none;
  }

  .full-modal-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .full-modal {
    background: #ffffff;
    width: 340px;
    max-width: 92vw;
    max-height: 90vh;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    overflow: hidden !important;
    overflow-x: hidden !important;
    overflow-y: hidden !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    position: relative;
    padding: 24px;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    box-sizing: border-box;
    transform: translateY(12px);
    transition: transform 0.22s ease;
  }

  .full-modal::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .full-modal-overlay.is-visible .full-modal {
    transform: translateY(0);
  }

  /* Minimal Close Icon 'X' */
  .full-modal__close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    font-size: 20px;
    font-weight: 300;
    line-height: 1;
    color: #000000;
    cursor: pointer;
    padding: 4px;
    transition: opacity 0.15s ease;
  }

  .full-modal__close:hover {
    opacity: 0.6;
  }

  /* Header Section */
  .full-modal__top-row {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
  }

  .full-modal__image-wrap {
    width: 110px;
    height: 110px;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    overflow: hidden;
    background: #f7f7f7;
    border-radius: 0;
  }

  .full-modal__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .full-modal__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .full-modal__title {
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 6px 0;
    color: #111111;
  }

  .full-modal__price {
    font-family: 'Lustria', var(--font-heading--family, Georgia, serif);
    font-size: 16px;
    font-weight: 400;
    color: #000000;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .full-modal__description {
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.45;
    color: #666666;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Option Group Labels */
  .modal-option-group {
    margin-bottom: 16px;
  }

  .modal-option-label {
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 400;
    color: #333333;
    display: block;
    margin-bottom: 7px;
    text-transform: none;
  }

  /* Variant Selector Buttons */
  .modal-swatch-row {
    position: relative;
    display: flex;
    width: 100%;
    gap: 0;
  }

  .modal-swatch {
    position: relative;
    flex: 1;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #000000 !important;
    cursor: pointer;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 14px;
    font-weight: 400;
    text-align: center;
    user-select: none;
    outline: none;
    box-sizing: border-box;
    border-radius: 0;
    overflow: hidden;
    transition: background-color 250ms ease, color 250ms ease;
  }

  .modal-swatch + .modal-swatch {
    border-left: none !important;
  }

  /* Selected State: Solid Black background, White text */
  .modal-swatch.is-selected,
  .modal-swatch.active {
    background: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }

  /* Swatch Text */
  .modal-swatch-text {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #000000 !important;
    font-weight: 400;
    transition: color 250ms ease, font-weight 250ms ease;
  }

  .modal-swatch.is-selected .modal-swatch-text,
  .modal-swatch.active .modal-swatch-text {
    color: #ffffff !important;
    font-weight: 600 !important;
  }

  /* 5px Vertical Rectangle Attached to Left Edge (Color set dynamically by JS based on variant name) */
  .modal-swatch-indicator {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px !important;
    height: 100% !important;
    border-radius: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    z-index: 5;
    pointer-events: none;
  }

  /* Size Dropdown Styling */
  .modal-custom-select-wrap {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .modal-size-select-box {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }

  .modal-size-select-main {
    flex: 1;
    height: 44px;
    padding: 0 16px;
    border: 1px solid #000000;
    background: #ffffff;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 14px;
    color: #000000;
    text-align: left;
    display: flex;
    align-items: center;
    cursor: pointer;
    outline: none;
    box-sizing: border-box;
    border-radius: 0;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .modal-size-select-main:active {
    transform: scale(0.98);
  }

  .modal-size-select-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid #000000;
    margin-left: -1px;
    background: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    outline: none;
    box-sizing: border-box;
    border-radius: 0;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .modal-size-select-arrow:active {
    transform: scale(0.98);
  }

  .modal-caret-icon {
    transition: transform 0.2s ease;
    transform: rotate(0deg);
  }

  .modal-size-select-box.is-open .modal-caret-icon {
    transform: rotate(180deg);
  }

  /* Dropdown Menu List: Always opens BELOW input, max-height 180px, HIDDEN SCROLLBAR across all browsers */
  .modal-custom-select-list,
  .modal-custom-select-list ul {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-width: 100%;
    max-height: 180px;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    box-sizing: border-box;
    z-index: 1000;
    background: #ffffff;
    border: 1px solid #D9D9D9;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    margin-top: 4px;
    padding: 0 !important;
    margin-bottom: 0 !important;
    list-style: none !important;
    display: none;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .modal-custom-select-list::-webkit-scrollbar,
  .modal-custom-select-list ul::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .modal-custom-select-list.is-visible {
    display: block;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .modal-custom-select-option {
    padding: 12px 16px;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 14px;
    color: #000000 !important;
    text-align: center;
    cursor: pointer !important;
    background: #ffffff !important;
    border-bottom: 1px solid #eeeeee;
    box-sizing: border-box;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .modal-custom-select-option:last-child {
    border-bottom: none;
  }

  .modal-custom-select-option:hover,
  .modal-custom-select-option:focus {
    background: #000000 !important;
    color: #ffffff !important;
  }

  /* Add To Cart Button: PERMANENTLY SOLID BLACK (#000000) IN ALL STATES */
  .full-modal__add-btn,
  .full-modal__add-btn:hover,
  .full-modal__add-btn:active,
  .full-modal__add-btn:focus,
  .full-modal__add-btn:visited,
  .full-modal__add-btn:disabled,
  .full-modal__add-btn.is-loading,
  .full-modal__add-btn.is-added {
    position: relative;
    width: 100%;
    height: 48px;
    margin-top: 20px;
    background: #000000 !important;
    background-color: #000000 !important;
    color: #ffffff !important;
    border: none !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 0 44px;
    font-family: 'Jost', var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    box-sizing: border-box;
    opacity: 1;
    transition: opacity 0.2s ease, box-shadow 0.2s ease;
    outline: none !important;
    box-shadow: none;
  }

  .full-modal__add-btn:hover {
    opacity: 0.9 !important;
  }

  .full-modal__add-btn:active {
    opacity: 0.95 !important;
  }

  .full-modal__add-btn span {
    position: relative;
    z-index: 1;
    text-align: center;
    width: 100%;
    display: block;
  }

  .full-modal__add-btn svg {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 12px;
    color: #ffffff !important;
    stroke: #ffffff !important;
    pointer-events: none;
  }
</style>

<div id="full-modal-overlay" class="full-modal-overlay" hidden>
  <div class="full-modal" role="dialog" aria-modal="true" aria-labelledby="modal-product-title">

    <!-- Minimal Top Right Close Icon 'X' -->
    <button id="full-modal-close" class="full-modal__close" aria-label="Close">&times;</button>

    <!-- Top Section: Product Info (Square Image + Title, Price, Description) -->
    <div class="full-modal__top-row">
      <div class="full-modal__image-wrap">
        <img id="modal-product-image" class="full-modal__image" src="" alt="" loading="lazy">
      </div>
      <div class="full-modal__info">
        <h3 id="modal-product-title" class="full-modal__title"></h3>
        <p  id="modal-product-price" class="full-modal__price"></p>
        <div id="modal-product-description" class="full-modal__description"></div>
      </div>
    </div>

    <!-- Variant Options (Color swatches & Size custom dropdown injected by JS) -->
    <div id="modal-options-wrap"></div>

    <!-- Add to Cart Button -->
    <button id="modal-add-to-cart" class="full-modal__add-btn" type="button" disabled>
      <span>ADD TO CART</span>
      <svg width="24" height="12" viewBox="0 0 24 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 6H22M22 6L16 1M22 6L16 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

  </div>
</div>
