<!-- Gift Guide Hero Banner - Matching Exact Figma Dimensions (1440x878 Output Frame) -->
<section class="gift-hero" id="gift-hero-section-{{ section.id }}" style="
  background-color: {{ section.settings.bg_color | default: '#ffffff' }};
">
  <!-- Outer Output Frame: Width 1440px, Height 878px -->
  <div class="gift-hero__output-frame">

    <!-- 0. Top Header Bar: TISSO VISON / Find the ideal gift / CHOOSE GIFT -->
    <div class="gift-hero__top-bar">
      <!-- Hamburger Menu (Mobile Only) -->
      <button class="gift-hero__hamburger" aria-label="Menu" type="button">
        {% render 'icon-hamburger' %}
        <span class="close-icon" style="display: none;">{% render 'icon-close' %}</span>
      </button>

      <!-- Left: Logo "TISSO VISON" -->
      <div class="gift-hero__logo">
        {{ section.settings.top_logo_text | default: 'TISSO VISON' }}
      </div>

      <!-- Spacer for 3-column layout centering (Mobile Only) -->
      <div class="gift-hero__top-spacer"></div>

      <!-- Center: "Find the ideal gift for your loved ones." -->
      <div class="gift-hero__top-subtext">
        {{ section.settings.top_subtext | default: 'Find the ideal gift for your loved ones.' }}
      </div>

      <!-- Right: Action Button "CHOOSE GIFT →" -->
      {% if section.settings.top_btn_text != blank %}
        <a href="{{ section.settings.top_btn_link | default: '#' }}" class="gift-hero__top-btn">
          {{ section.settings.top_btn_text }}
          <svg width="33.7" height="16" viewBox="0 0 28 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 8H26M26 8L19 1M26 8L19 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- Mobile Menu Dropdown Panel -->
    <div class="gift-hero__mobile-menu-panel">
      <div class="gift-hero__mobile-menu-subtext">
        {{ section.settings.top_subtext | default: 'Find the ideal gift for your loved ones.' }}
      </div>
      {% if section.settings.top_btn_text != blank %}
        <a href="{{ section.settings.top_btn_link | default: '#' }}" class="gift-hero__mobile-menu-btn">
          <span>{{ section.settings.top_btn_text }}</span>
          {% render 'icon-arrow-right' %}
        </a>
      {% endif %}
    </div>

    <!-- Mobile Hero Block (Visible only on Mobile) -->
    <div class="gift-hero__mobile-hero">
      {% if section.settings.heading != blank %}
        <h1 class="gift-hero__mobile-title">{{ section.settings.heading }}</h1>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <div class="gift-hero__mobile-description">
          {{ section.settings.description | strip_html | split: '.' | first | replace: 'Destination', '<br>Destination' }}.
        </div>
      {% endif %}

      <div class="gift-hero__mobile-illus-container">
        <img src="{{ 'Frame3.png' | asset_url }}" class="gift-hero__mobile-illus-img" alt="" width="375" height="231" loading="eager">
      </div>

      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="gift-hero__mobile-btn">
          <span>{{ section.settings.btn_text }}</span>
          {% render 'icon-arrow-right' %}
        </a>
      {% endif %}
    </div>

    <!-- 1. Top Large Background Image: Width 1440px (100%), Height 390px (44.42%), Top 64px (7.29%) -->
    <div class="gift-hero__bg-top">
      <img
        src="{% if section.settings.bg_image_top != blank %}{{ section.settings.bg_image_top | image_url: width: 2400 }}{% elsif section.settings.bg_image != blank %}{{ section.settings.bg_image | image_url: width: 2400 }}{% else %}{{ 'Frame2.png' | asset_url }}{% endif %}"
        alt="{{ section.settings.heading | default: 'Gift guide top background' }}"
        class="gift-hero__bg-img gift-hero__bg-img--top"
        loading="eager"
      >
    </div>

    <!-- 2. Bottom-Right Background Image: Width 890px (61.81%), Height 402px (45.79%), Top 442px (50.34%), Left 550px (38.19%) -->
    <div class="gift-hero__bg-bottom-right">
      <img
        src="{% if section.settings.bg_image_bottom != blank %}{{ section.settings.bg_image_bottom | image_url: width: 1800 }}{% elsif section.settings.bg_image != blank %}{{ section.settings.bg_image | image_url: width: 1800 }}{% else %}{{ 'Frame.png' | asset_url }}{% endif %}"
        alt="{{ section.settings.heading | default: 'Gift guide bottom background' }}"
        class="gift-hero__bg-img gift-hero__bg-img--bottom"
        loading="eager"
      >
    </div>

    <!-- Content Box: Width 483px (33.54%), Top 489px (55.69%), Left 67px (4.65%) -->
    <div class="gift-hero__content-box">
      {% if section.settings.heading != blank %}
        <h1 class="gift-hero__title" style="color: {{ section.settings.heading_color | default: '#000000' }};">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="gift-hero__description" style="color: {{ section.settings.text_color | default: '#1a1a1a' }};">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="gift-hero__btn">
          {{ section.settings.btn_text }}
          {% render 'icon-arrow-right' %}
        </a>
      {% endif %}
    </div>

    <!-- Optional Illustration Overlay Blocks -->
    {% for block in section.blocks %}
      {% if block.settings.illustration_type != blank %}
        <div class="gift-hero__illustration-wrap" {{ block.shopify_attributes }} style="
          left: {{ block.settings.position_left }}%;
          top: {{ block.settings.position_top }}%;
          width: {{ block.settings.width }}%;
        ">
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="gift-hero__illustration-link" aria-label="Illustration link">
          {% endif %}
          <img
            src="{{ block.settings.illustration_type | asset_url }}"
            class="gift-hero__illustration-img"
            alt=""
            loading="lazy"
          >
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    <!-- Bottom Tagline -->
    {% if section.settings.bottom_text != blank %}
      <div class="gift-hero__tagline" style="color: {{ section.settings.tagline_color | default: '#555555' }};">
        <span class="tagline-desktop">{{ section.settings.bottom_text }}</span>
        <span class="tagline-mobile">{{ section.settings.bottom_text | replace: 'CLOTHES IN SIZES XXS TO 6XL.', 'ACTIVEWEAR' }}</span>
      </div>
    {% endif %}

  </div>
</section>

{{ 'gift-guide-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide-hero.js' | asset_url }}" defer="defer"></script>

